{
  "name": "orphaleia-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "measure:performance": "node scripts/measure-performance.mjs",
    "openapi": "cd ../api && .venv/bin/python scripts/export_openapi.py /tmp/orphaleia-openapi.json && cd ../web && openapi-typescript /tmp/orphaleia-openapi.json -o src/generated/api.d.ts",
    "openapi:ci": "cd ../api && if [ -x .venv/bin/python ]; then .venv/bin/python scripts/export_openapi.py /tmp/orphaleia-openapi.json; else python3 scripts/export_openapi.py /tmp/orphaleia-openapi.json; fi && cd ../web && openapi-typescript /tmp/orphaleia-openapi.json -o src/generated/api.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.85.5",
    "cobe": "^2.0.1",
    "gsap": "^3.15.0",
    "openapi-fetch": "^0.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-pageflip": "^2.0.3",
    "react-router-dom": "^7.8.2",
    "three": "^0.185.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.9.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
